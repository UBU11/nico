# Neon Postgres Pooled TCP Endpoint (Required in production)
DATABASE_URL=postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require

# Application Gateway Port (Optional, default 3000)
PORT=3000

# Node Environment (development | test | production)
NODE_ENV=development

# Podman Rootless UNIX Socket Path (Optional, resolved dynamically if unset)
# PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock

# Langfuse Telemetry Credentials (Optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
